{
    "name": "kopexa/mautic-oauth-bundle",
    "description": "OAuth 2.1 authorization server for Mautic (authorization code + PKCE S256, refresh tokens, dynamic client registration, RFC 8414 metadata, JWKS). Used by MCP clients such as Claude and ChatGPT.",
    "type": "mautic-plugin",
    "version": "0.2.0",
    "license": "Apache-2.0",
    "keywords": [
        "mautic",
        "plugin",
        "oauth2",
        "oauth2.1",
        "pkce",
        "mcp"
    ],
    "homepage": "https://github.com/kopexa-grc/mautic-stack",
    "authors": [
        {
            "name": "Kopexa",
            "homepage": "https://kopexa.com"
        }
    ],
    "extra": {
        "install-directory-name": "KopexaOAuthBundle"
    },
    "require": {
        "php": "^8.2",
        "ext-openssl": "*",
        "mautic/core-lib": "^7.0",
        "league/oauth2-server": "^9.4",
        "guzzlehttp/psr7": "^2.7",
        "defuse/php-encryption": "^2.4"
    }
}
