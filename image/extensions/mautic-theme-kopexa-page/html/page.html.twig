{% extends "@themes/"~template~"/html/base.html.twig" %}
{# Kopexa lead magnet landing page (brand.kopexa.com).
   One offer (a free checklist), asked for with one field. Structure:
   hero (promise + inline email form | art-directed preview), audience,
   self-check (CSS only), outcomes bento, contents, questions, closing CTA.
   White base, text #10253D, Action Blue for actions, Navy brand surfaces
   with the open route; flat colours, radii from the tokens. Mobile first.
   Fonts and logo come from the base theme (themes/kopexa). #}
{% set kx = 'themes/kopexa/assets/' %}

{% block content %}
<style>
  @font-face { font-family: 'IBM Plex Sans'; font-weight: 600; font-style: normal; font-display: swap; src: url('{{ getAssetUrl(kx~'fonts/IBM-Plex-Sans-600.ttf', null, null, true) }}') format('truetype'); }
  @font-face { font-family: 'Inter'; font-weight: 400; font-style: normal; font-display: swap; src: url('{{ getAssetUrl(kx~'fonts/Inter-400.ttf', null, null, true) }}') format('truetype'); }
  @font-face { font-family: 'Inter'; font-weight: 600; font-style: normal; font-display: swap; src: url('{{ getAssetUrl(kx~'fonts/Inter-600.ttf', null, null, true) }}') format('truetype'); }
  @font-face { font-family: 'Geist Mono'; font-weight: 400; font-style: normal; font-display: swap; src: url('{{ getAssetUrl(kx~'fonts/Geist-Mono-400.ttf', null, null, true) }}') format('truetype'); }

  /* Brand tokens (brand.kopexa.com/brand/tokens.json); --kx-muted and
     --kx-line are derived for white surfaces (muted text keeps > 4.5:1). */
  :root {
    --kx-navy: #070B14; --kx-surface: #101827; --kx-text: #10253D; --kx-white: #FFFFFF;
    --kx-action: #006CB8; --kx-action-hover: #005B9B; --kx-route: #0E9DFD;
    --kx-supporting: #B9C8D7;
    --kx-muted: #475B70; --kx-line: #E1E6EC;
    --kx-r-small: 6px; --kx-r-control: 8px; --kx-r-panel: 14px; --kx-r-frame: 24px;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; background: var(--kx-white); color: var(--kx-text); font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 16px; line-height: 1.6; -webkit-font-smoothing: antialiased; }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--kx-action); }
  a:focus-visible, button:focus-visible, input:focus-visible, summary:focus-visible, label:focus-within { outline: 2px solid var(--kx-action); outline-offset: 3px; }
  .kx-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .kx-container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  .kx-section { padding: 64px 0; }
  .kx-label { font-family: 'Geist Mono', ui-monospace, Menlo, monospace; font-size: 13px; letter-spacing: .04em; color: var(--kx-action); margin: 0 0 14px; }
  .kx-h1, .kx-h2, .kx-h3 { font-family: 'IBM Plex Sans', Inter, Helvetica, Arial, sans-serif; font-weight: 600; color: var(--kx-navy); margin: 0; }
  .kx-h1 { font-size: 44px; line-height: 1.02; letter-spacing: -.03em; }
  .kx-h2 { font-size: 30px; line-height: 1.12; letter-spacing: -.02em; }
  .kx-h3 { font-size: 20px; line-height: 1.25; letter-spacing: -.01em; }
  .kx-sub { font-size: 20px; line-height: 1.45; color: var(--kx-text); margin: 18px 0 0; max-width: 30ch; }
  .kx-text { color: var(--kx-muted); margin: 10px 0 0; max-width: 60ch; }
  .kx-button { display: block; text-align: center; background: var(--kx-action); color: var(--kx-white) !important; text-decoration: none; font-weight: 600; font-size: 17px; line-height: 1.25; padding: 15px 24px; border-radius: var(--kx-r-control); min-height: 52px; border: 0; }
  .kx-button:hover { background: var(--kx-action-hover); }

  /* header */
  .kx-header .kx-container { display: flex; align-items: center; justify-content: space-between; min-height: 68px; }
  .kx-logo { height: 26px; width: auto; }
  .kx-header-link { font-weight: 600; font-size: 15px; text-decoration: none; padding: 10px 0; }
  .kx-header-link:hover { text-decoration: underline; }

  /* hero */
  .kx-hero { padding: 16px 0 64px; }
  .kx-hero-grid { display: grid; gap: 40px; align-items: center; }
  .kx-pill { display: inline-flex; align-items: center; gap: 8px; font-family: 'Geist Mono', ui-monospace, Menlo, monospace; font-size: 13px; color: var(--kx-navy); border: 1px solid var(--kx-line); border-radius: var(--kx-r-control); padding: 6px 14px 6px 6px; margin: 0 0 22px; }
  .kx-pill b { font-weight: 400; color: var(--kx-white); background: var(--kx-action); border-radius: var(--kx-r-small); padding: 2px 10px; }

  /* the form: one field and the button side by side from 640 px */
  .kx-capture { margin-top: 28px; max-width: 520px; }
  .kx-form-note { font-size: 13px; color: var(--kx-muted); border: 1px dashed var(--kx-supporting); border-radius: var(--kx-r-small); padding: 8px 12px; margin: 0 0 12px; }
  .kx-capture .mauticform_wrapper { max-width: none !important; margin: 0 !important; }
  .kx-capture .mauticform-page-wrapper, .kx-mock { display: grid; gap: 10px; }
  .kx-capture .mauticform-row { margin: 0 !important; }
  .kx-capture .mauticform-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .mauticform-input { width: 100%; font: inherit; font-size: 17px; color: var(--kx-text); min-height: 52px; padding: 13px 16px; border: 1px solid var(--kx-supporting); border-radius: var(--kx-r-control); background: var(--kx-white); }
  .mauticform-input::placeholder { color: var(--kx-muted); }
  .mauticform-input:focus { outline: 2px solid var(--kx-action); outline-offset: 1px; border-color: var(--kx-action); }
  .mauticform-button { width: 100%; min-height: 52px; background: var(--kx-action) !important; color: var(--kx-white) !important; border: 0 !important; font: inherit; font-weight: 600; font-size: 17px; padding: 14px 22px !important; border-radius: var(--kx-r-control) !important; cursor: pointer; white-space: nowrap; }
  .mauticform-button:hover { background: var(--kx-action-hover) !important; }
  .mauticform-errormsg { color: #B42318; font-size: 13px; }
  .mauticform-message { color: var(--kx-text); font-weight: 600; }
  .kx-fine { font-size: 13px; color: var(--kx-muted); margin: 12px 0 0; }
  .kx-fine a { color: var(--kx-muted); }

  /* preview: two pages of the checklist on the brand surface */
  .kx-stage { position: relative; overflow: hidden; background: var(--kx-navy); border-radius: var(--kx-r-frame); height: 470px; }
  .kx-stage-route { position: absolute; inset: 0; width: 100%; height: 100%; }
  .kx-sheet { position: absolute; background: var(--kx-white); border-radius: var(--kx-r-panel); }
  .kx-sheet--front { left: 24px; right: 24px; top: 34px; max-width: 330px; padding: 20px; }
  .kx-next { position: absolute; left: 44px; right: 20px; bottom: 20px; background: var(--kx-white); border-radius: var(--kx-r-panel); padding: 14px 16px; border: 2px solid var(--kx-action); }
  .kx-next small { display: block; font-family: 'Geist Mono', ui-monospace, Menlo, monospace; font-size: 11px; color: var(--kx-action); }
  .kx-next strong { display: block; font-family: 'IBM Plex Sans', Inter, Helvetica, Arial, sans-serif; font-weight: 600; font-size: 15px; line-height: 1.3; color: var(--kx-navy); margin-top: 4px; }
  .kx-next span { display: block; font-size: 12px; color: var(--kx-muted); margin-top: 6px; }
  .kx-sheet-head { display: flex; align-items: center; justify-content: space-between; }
  .kx-sheet-logo { height: 13px; width: auto; }
  .kx-sheet-tag { font-family: 'Geist Mono', ui-monospace, Menlo, monospace; font-size: 11px; color: var(--kx-muted); }
  .kx-sheet-title { font-family: 'IBM Plex Sans', Inter, Helvetica, Arial, sans-serif; font-weight: 600; font-size: 19px; line-height: 1.2; color: var(--kx-navy); margin: 14px 0 12px; }
  .kx-progress { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--kx-muted); margin-bottom: 10px; }
  .kx-progress span { flex: 1; height: 6px; border-radius: var(--kx-r-small); background: var(--kx-line); overflow: hidden; }
  .kx-progress span::before { content: ''; display: block; width: 62%; height: 100%; background: var(--kx-action); }
  .kx-row { display: flex; gap: 10px; align-items: center; font-size: 13px; color: var(--kx-text); padding: 8px 0; border-top: 1px solid var(--kx-line); }
  .kx-row--next { font-weight: 600; color: var(--kx-navy); }
  .kx-row em { margin-left: auto; font-style: normal; font-family: 'Geist Mono', ui-monospace, Menlo, monospace; font-size: 11px; color: var(--kx-white); background: var(--kx-action); border-radius: var(--kx-r-small); padding: 2px 8px; white-space: nowrap; }
  .kx-row--extra { display: none; }
  .kx-box { width: 18px; height: 18px; flex: none; border-radius: var(--kx-r-small); border: 1.5px solid var(--kx-supporting); position: relative; }
  .kx-box--done { background: var(--kx-action); border-color: var(--kx-action); }
  .kx-box--done::after { content: ''; position: absolute; left: 5px; top: 1.5px; width: 4px; height: 9px; border: solid var(--kx-white); border-width: 0 2px 2px 0; transform: rotate(45deg); }

  /* audience */
  .kx-audience { border-top: 1px solid var(--kx-line); border-bottom: 1px solid var(--kx-line); padding: 22px 0; }
  .kx-audience .kx-container { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 28px; }
  .kx-audience p { margin: 0; font-size: 14px; color: var(--kx-muted); }
  .kx-audience ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .kx-audience li { font-family: 'IBM Plex Sans', Inter, Helvetica, Arial, sans-serif; font-weight: 600; font-size: 17px; color: var(--kx-navy); }

  /* self-check: three questions, the answer changes with the ticks (CSS :has) */
  .kx-check { display: grid; gap: 32px; }
  .kx-quiz { display: grid; gap: 10px; }
  .kx-q { display: flex; gap: 14px; align-items: center; border: 1px solid var(--kx-line); border-radius: var(--kx-r-panel); padding: 16px 18px; cursor: pointer; font-weight: 600; color: var(--kx-navy); min-height: 64px; }
  .kx-q input { appearance: none; -webkit-appearance: none; margin: 0; width: 24px; height: 24px; flex: none; border: 1.5px solid var(--kx-supporting); border-radius: var(--kx-r-small); position: relative; cursor: pointer; }
  .kx-q input:checked { background: var(--kx-action); border-color: var(--kx-action); }
  .kx-q input:checked::after { content: ''; position: absolute; left: 7px; top: 3px; width: 6px; height: 11px; border: solid var(--kx-white); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .kx-q:has(input:checked) { border-color: var(--kx-action); }
  .kx-answer { border-radius: var(--kx-r-panel); background: var(--kx-navy); color: var(--kx-white); padding: 24px; }
  .kx-answer .kx-label { color: var(--kx-supporting); }
  .kx-answer p { margin: 0; }
  .kx-answer-text { font-family: 'IBM Plex Sans', Inter, Helvetica, Arial, sans-serif; font-weight: 600; font-size: 21px; line-height: 1.3; }
  .kx-answer .kx-button { margin-top: 20px; }
  .kx-answer-all { display: none; }
  .kx-check:has(.kx-q input:not(:checked)) .kx-answer-all { display: none; }
  .kx-check:not(:has(.kx-q input:not(:checked))) .kx-answer-open { display: none; }
  .kx-check:not(:has(.kx-q input:not(:checked))) .kx-answer-all { display: block; }

  /* outcomes bento */
  .kx-bento { display: grid; gap: 16px; margin-top: 36px; }
  .kx-tile { border: 1px solid var(--kx-line); border-radius: var(--kx-r-panel); padding: 24px; display: flex; flex-direction: column; }
  .kx-tile .kx-h3 { margin-top: 20px; }
  .kx-viz { border-radius: var(--kx-r-control); background: var(--kx-navy); padding: 18px; min-height: 132px; color: var(--kx-white); font-size: 13px; }
  .kx-meter { display: grid; gap: 10px; }
  .kx-meter div { display: grid; grid-template-columns: 92px 1fr; align-items: center; gap: 10px; color: var(--kx-supporting); }
  .kx-meter span { height: 8px; border-radius: var(--kx-r-small); background: var(--kx-surface); overflow: hidden; }
  .kx-meter span::before { content: ''; display: block; height: 100%; background: var(--kx-action); }
  .kx-meter .m1::before { width: 90%; } .kx-meter .m2::before { width: 55%; } .kx-meter .m3::before { width: 25%; }
  .kx-prio { display: grid; gap: 8px; }
  .kx-prio div { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: var(--kx-r-small); background: var(--kx-surface); color: var(--kx-supporting); }
  .kx-prio .first { background: var(--kx-white); color: var(--kx-navy); font-weight: 600; }
  .kx-prio b { font-family: 'Geist Mono', ui-monospace, Menlo, monospace; font-weight: 400; color: var(--kx-supporting); }
  .kx-prio .first b { color: var(--kx-action); }
  .kx-chat { display: grid; gap: 8px; }
  .kx-chat p { margin: 0; padding: 9px 12px; border-radius: var(--kx-r-control); max-width: 88%; }
  .kx-chat .them { background: var(--kx-surface); color: var(--kx-supporting); }
  .kx-chat .us { background: var(--kx-white); color: var(--kx-navy); justify-self: end; font-weight: 600; }

  /* contents */
  .kx-contents { display: grid; gap: 32px; }
  .kx-items { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--kx-line); }
  .kx-items li { display: flex; gap: 14px; align-items: flex-start; padding: 15px 0; border-bottom: 1px solid var(--kx-line); font-size: 17px; color: var(--kx-navy); }
  .kx-items .kx-box { margin-top: 4px; }

  /* questions: native details, no script */
  .kx-faq { border-top: 1px solid var(--kx-line); }
  .kx-faq details { border-bottom: 1px solid var(--kx-line); }
  .kx-faq summary { cursor: pointer; list-style: none; padding: 18px 40px 18px 0; min-height: 52px; position: relative; font-weight: 600; font-size: 17px; color: var(--kx-navy); }
  .kx-faq summary::-webkit-details-marker { display: none; }
  .kx-faq summary::after { content: '+'; position: absolute; right: 6px; top: 13px; font-size: 24px; color: var(--kx-action); }
  .kx-faq details[open] summary::after { content: '–'; }
  .kx-faq details p { margin: 0 0 18px; color: var(--kx-muted); max-width: 70ch; }

  /* closing call to action */
  .kx-brand { position: relative; overflow: hidden; background: var(--kx-navy); border-radius: var(--kx-r-frame); padding: 44px 24px 196px; }
  .kx-brand > * { position: relative; }
  .kx-brand .kx-label { color: var(--kx-supporting); }
  .kx-brand .kx-h2 { color: var(--kx-white); }
  .kx-brand .kx-text { color: var(--kx-supporting); }
  .kx-brand .kx-button { margin-top: 28px; }
  .kx-route { position: absolute !important; left: 0; right: 0; bottom: 0; width: 100%; height: 170px; pointer-events: none; }
  .kx-route--wide { display: none; }

  /* footer */
  .kx-footer { border-top: 1px solid var(--kx-line); padding: 24px 0 32px; font-size: 14px; color: var(--kx-muted); }
  .kx-footer .kx-container { display: flex; flex-direction: column; gap: 12px; }
  .kx-footer nav { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .kx-footer a { color: var(--kx-muted); text-decoration: none; padding: 4px 0; }
  .kx-footer a:hover { color: var(--kx-action); text-decoration: underline; }

  @media (min-width: 640px) {
    .kx-container { padding: 0 32px; }
    .kx-h1 { font-size: 60px; }
    .kx-capture .mauticform-page-wrapper, .kx-mock { grid-template-columns: 1fr auto; }
    /* email + button share a row; any further fields take a full row */
    .kx-capture .mauticform-page-wrapper > .mauticform-row:not(.mauticform-email):not(.mauticform-button-wrapper) { grid-column: 1 / -1; }
    .kx-stage { height: 470px; }
    .kx-row--extra { display: flex; }
    .kx-next { left: auto; width: 240px; }
    .kx-sheet--front { left: 40px; top: 44px; }
    .kx-brand .kx-button { display: inline-block; }
    .kx-footer .kx-container { flex-direction: row; justify-content: space-between; align-items: center; }
  }
  @media (min-width: 800px) {
    .kx-bento { grid-template-columns: repeat(3, 1fr); }
    .kx-brand { padding: 72px 56px; }
    .kx-brand > *:not(.kx-route) { max-width: 54%; }
    .kx-route { left: auto; top: 0; width: 44%; height: 100%; }
    .kx-route--wide { display: block; }
    .kx-route--narrow { display: none; }
  }
  @media (min-width: 1024px) {
    .kx-h1 { font-size: 76px; }
    .kx-h2 { font-size: 42px; }
    .kx-sub { font-size: 22px; }
    .kx-hero { padding: 40px 0 96px; }
    .kx-hero-grid { grid-template-columns: 1.05fr 1fr; gap: 64px; }
    .kx-stage { height: 540px; }
    .kx-sheet--front { left: 48px; top: 56px; max-width: 360px; padding: 24px; }
    .kx-next { right: 40px; bottom: 48px; width: 250px; padding: 16px 18px; }
    .kx-section { padding: 112px 0; }
    .kx-check { grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
    .kx-contents { grid-template-columns: .9fr 1.1fr; gap: 64px; }
  }
</style>

<header class="kx-header">
  <div class="kx-container">
    <img class="kx-logo" src="{{ getAssetUrl(kx~'logo-dark.png', null, null, true) }}" alt="Kopexa" width="102" height="26">
    <a class="kx-header-link" href="#download">Checkliste sichern</a>
  </div>
</header>

<main>
<section class="kx-hero">
  <div class="kx-container kx-hero-grid">
    <div id="download">
      <p class="kx-pill"><b>Kostenlos</b>NIS2-Checkliste für Entscheider</p>
      <h1 class="kx-h1">Wo steht ihr bei NIS2?</h1>
      <p class="kx-sub">Nach einem Nachmittag weißt du es. Mit einfachen Fragen statt Gesetzestext.</p>
      <div class="kx-capture">
        <p class="kx-form-note">Vorschau – im Builder den Block „Form“ hierher ziehen und ein Formular mit dem Feld E-Mail wählen.</p>
        <div class="kx-mock">
          <label class="kx-sr" for="kx-mock-email">Geschäftliche E-Mail</label>
          <input class="mauticform-input" id="kx-mock-email" type="email" placeholder="Deine geschäftliche E-Mail" disabled>
          <button class="mauticform-button" type="button" disabled>Checkliste erhalten</button>
        </div>
      </div>
      <p class="kx-fine">Kostenlos als PDF. Abmeldung jederzeit. Es gilt unsere <a href="https://kopexa.com/de/legal/privacy">Datenschutzerklärung</a>.</p>
    </div>

    <div class="kx-stage" aria-hidden="true">
      <svg class="kx-stage-route" viewBox="640 0 960 1000" preserveAspectRatio="xMaxYMid slice" focusable="false"><path d="M760 1150C760 870 835 783 1070 704C1264 639 1320 568 1301 390C1285 240 1447 135 1700 135" fill="none" stroke="#0E9DFD" stroke-width="190"/></svg>
      <div class="kx-sheet kx-sheet--front">
        <div class="kx-sheet-head"><img class="kx-sheet-logo" src="{{ getAssetUrl(kx~'logo-dark.png', null, null, true) }}" alt="" width="51" height="13"><span class="kx-sheet-tag">Seite 1</span></div>
        <p class="kx-sheet-title">Wo stehen wir?</p>
        <div class="kx-progress"><span></span>5 von 8 geklärt</div>
        <div class="kx-row"><span class="kx-box kx-box--done"></span>Wer übernimmt im Ernstfall?</div>
        <div class="kx-row"><span class="kx-box kx-box--done"></span>Können wir nach einem Ausfall weiterarbeiten?</div>
        <div class="kx-row kx-row--next"><span class="kx-box"></span>Welche Lieferanten sind kritisch?<em>Als Nächstes</em></div>
        <div class="kx-row kx-row--extra"><span class="kx-box"></span>Wer meldet was an wen?</div>
      </div>
      <div class="kx-next"><small>Dein nächster Schritt</small><strong>Kritische Lieferanten einordnen</strong><span>Zuständig: Einkauf · bis Freitag</span></div>
    </div>
  </div>
</section>

<section class="kx-audience">
  <div class="kx-container">
    <p>Gemacht für Verantwortliche in</p>
    <ul><li>Mittelstand</li><li>Stadtwerken</li><li>Kliniken</li><li>IT-Dienstleistern</li><li>KRITIS</li></ul>
  </div>
</section>

<section class="kx-section">
  <div class="kx-container kx-check">
    <div>
      <h2 class="kx-h2">Drei Fragen. Kannst du sie sofort beantworten?</h2>
      <p class="kx-text">Hake ab, was bei euch geklärt ist. Ehrlich – es sieht ja niemand.</p>
    </div>
    <div class="kx-quiz">
      <label class="kx-q"><input type="checkbox">Ich weiß, wer bei einem Vorfall die Entscheidungen trifft.</label>
      <label class="kx-q"><input type="checkbox">Wir könnten nach einem Ausfall in kurzer Zeit weiterarbeiten.</label>
      <label class="kx-q"><input type="checkbox">Ich weiß, welche Lieferanten für uns kritisch sind.</label>
      <div class="kx-answer" aria-live="polite">
        <p class="kx-label">Deine Einschätzung</p>
        <p class="kx-answer-text kx-answer-open">Mindestens eine Frage ist offen. Genau dafür ist die Checkliste gemacht.</p>
