{
    "name": "kopexa/mautic-mcp-bundle",
    "description": "Model Context Protocol (MCP) server for Mautic: lets Claude, ChatGPT and other MCP clients read contacts, segments, emails and campaigns and write email and campaign drafts, with the user's Mautic permissions. OAuth 2.1 via kopexa/mautic-oauth-bundle.",
    "type": "mautic-plugin",
    "license": "Apache-2.0",
    "keywords": [
        "mautic",
        "plugin",
        "mcp",
        "model-context-protocol",
        "ai",
        "claude",
        "chatgpt"
    ],
    "homepage": "https://github.com/kopexa-grc/mautic-stack/tree/main/image/extensions/mautic-mcp-bundle",
    "support": {
        "issues": "https://github.com/kopexa-grc/mautic-stack/issues",
        "source": "https://github.com/kopexa-grc/mautic-mcp-bundle",
        "docs": "https://github.com/kopexa-grc/mautic-stack/tree/main/docs"
    },
    "authors": [
        {
            "name": "Kopexa",
            "homepage": "https://kopexa.com"
        }
    ],
    "extra": {
        "install-directory-name": "KopexaMcpBundle"
    },
    "require": {
        "php": "^8.2",
        "mautic/core-lib": "^7.0",
        "kopexa/mautic-oauth-bundle": "^0.2",
        "mcp/sdk": "^0.9",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/psr7": "^2.7",
        "symfony/cache": "^7.4"
    },
    "minimum-stability": "stable"
}
