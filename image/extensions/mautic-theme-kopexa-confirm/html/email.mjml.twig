{#
  Kopexa · Anmeldung bestätigen — part of the Kopexa email themes (see ../mautic-theme-kopexa).
  Head (fonts, tokens), header and footer are identical to the base theme
  "Kopexa"; qa/check.mjs enforces that. Fonts and logo are served from the
  base theme (themes/kopexa/assets), which this package requires.
  Double opt-in confirmation for the Leuchtfeuer DOI plugin (built into
  the image): the button links to {doi_link}, which the plugin fills in.
  Transactional: one task, no marketing content.
  Builder rules: see the base theme (bare <mjml>, no self-closing tags,
  an mj-class on every mj-section, mj-text and mj-button).
#}
<mjml>
  <mj-head>
    <mj-title>{subject}</mj-title>
    <!-- Brand fonts inline (no external stylesheet: avoids spam-filter
         penalties for external CSS; <link> is unsupported in most clients).
         Clients without web fonts use the system fallbacks below. -->
    <mj-style>
      @font-face { font-family: 'IBM Plex Sans'; font-weight: 600; font-style: normal; src: url('{{ getAssetUrl('themes/kopexa/assets/fonts/IBM-Plex-Sans-600.ttf', null, null, true) }}') format('truetype'); }
      @font-face { font-family: 'Inter'; font-weight: 400; font-style: normal; src: url('{{ getAssetUrl('themes/kopexa/assets/fonts/Inter-400.ttf', null, null, true) }}') format('truetype'); }
      @font-face { font-family: 'Inter'; font-weight: 600; font-style: normal; src: url('{{ getAssetUrl('themes/kopexa/assets/fonts/Inter-600.ttf', null, null, true) }}') format('truetype'); }
      @font-face { font-family: 'Geist Mono'; font-weight: 400; font-style: normal; src: url('{{ getAssetUrl('themes/kopexa/assets/fonts/Geist-Mono-400.ttf', null, null, true) }}') format('truetype'); }
    </mj-style>
    <mj-raw>
      <meta name="color-scheme" content="light only">
      <meta name="supported-color-schemes" content="light only">
    </mj-raw>
    <mj-attributes>
      <mj-all font-family="Inter, 'Segoe UI', Helvetica, Arial, sans-serif"></mj-all>
      <mj-text color="#10253D" font-size="16px" line-height="26px" padding="0 32px 16px 32px"></mj-text>
      <mj-button font-family="Inter, 'Segoe UI', Helvetica, Arial, sans-serif" font-weight="600" font-size="16px" border-radius="8px" inner-padding="14px 24px" padding="8px 32px 24px 32px" align="left"></mj-button>
      <mj-image padding="0"></mj-image>

      <!-- Builder tokens (GrapesJS) -->
      <mj-class name="t-body" font-size="16px" line-height="26px" color="#10253D"></mj-class>
      <mj-class name="t-lead" font-size="19px" line-height="30px" color="#10253D"></mj-class>
      <mj-class name="t-h1" font-family="'IBM Plex Sans', 'Segoe UI', Helvetica, Arial, sans-serif" font-weight="600" font-size="32px" line-height="40px" color="#070B14"></mj-class>
      <mj-class name="t-h2" font-family="'IBM Plex Sans', 'Segoe UI', Helvetica, Arial, sans-serif" font-weight="600" font-size="26px" line-height="34px" color="#070B14"></mj-class>
      <mj-class name="t-h3" font-family="'IBM Plex Sans', 'Segoe UI', Helvetica, Arial, sans-serif" font-weight="600" font-size="21px" line-height="28px" color="#070B14"></mj-class>
      <mj-class name="t-h4" font-family="'IBM Plex Sans', 'Segoe UI', Helvetica, Arial, sans-serif" font-weight="600" font-size="18px" line-height="26px" color="#070B14"></mj-class>
      <mj-class name="t-label" font-family="'Geist Mono', ui-monospace, Menlo, Consolas, monospace" font-size="12px" line-height="16px" letter-spacing="0.08em" color="#006CB8"></mj-class>
      <mj-class name="t-btn" font-weight="600" border-radius="8px" inner-padding="14px 24px"></mj-class>
      <mj-class name="t-btn-primary" background-color="#006CB8" color="#FFFFFF"></mj-class>
      <mj-class name="t-btn-secondary" background-color="#FFFFFF" color="#006CB8" border="1px solid #006CB8"></mj-class>
      <mj-class name="t-section" padding="0"></mj-class>
      <mj-class name="t-surface-1" background-color="#FFFFFF"></mj-class>

      <!-- Kopexa layout tokens (header, footer) -->
      <mj-class name="k-navy" background-color="#070B14"></mj-class>
      <mj-class name="k-claim" font-family="'IBM Plex Sans', 'Segoe UI', Helvetica, Arial, sans-serif" font-weight="600" font-size="18px" line-height="26px" color="#FFFFFF"></mj-class>
      <mj-class name="k-fine" font-size="13px" line-height="20px" color="#B9C8D7"></mj-class>
      <mj-class name="k-note" font-size="14px" line-height="22px" color="#10253D"></mj-class>
      <!-- Hero on the dark surface (theme "Kopexa · Hero + Split") -->
      <mj-class name="k-hero" background-color="#101827"></mj-class>
      <mj-class name="k-hero-label" font-family="'Geist Mono', ui-monospace, Menlo, Consolas, monospace" font-size="12px" line-height="16px" letter-spacing="0.08em" color="#B9C8D7"></mj-class>
      <mj-class name="k-hero-h1" font-family="'IBM Plex Sans', 'Segoe UI', Helvetica, Arial, sans-serif" font-weight="600" font-size="36px" line-height="44px" color="#FFFFFF"></mj-class>
      <mj-class name="k-hero-lead" font-size="19px" line-height="30px" color="#B9C8D7"></mj-class>
    </mj-attributes>
    <mj-style>
      a { color: #006CB8; }
      .k-footer a { color: #B9C8D7 !important; text-decoration: underline; }
      @media only screen and (max-width: 480px) {
        .k-panel { border-radius: 0 !important; }
        .k-hero-h1 div { font-size: 30px !important; line-height: 38px !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#070B14" width="640px">
    <!-- Header: original logo (white) on Navy -->
    <mj-section mj-class="k-navy" padding="32px 32px 24px 32px">
      <mj-column>
        <mj-image src="{{ getAssetUrl('themes/kopexa/assets/logo-light.png', null, null, true) }}" alt="Kopexa" width="140px" height="36px" align="left" href="https://www.kopexa.com/de"></mj-image>
      </mj-column>
    </mj-section>

    <!-- Content panel: one task, one button -->
    <mj-wrapper mj-class="t-surface-1" css-class="k-panel" border-radius="14px" padding="40px 0 16px 0">
      <mj-section mj-class="t-section t-surface-1">
        <mj-column>
          <mj-text mj-class="t-label" padding="0 32px 12px 32px">NEWSLETTER-ANMELDUNG</mj-text>
          <mj-text mj-class="t-h1" padding="0 32px 24px 32px"><h1 style="margin:0;font:inherit;color:inherit;">Bitte bestätige deine Anmeldung.</h1></mj-text>
          <mj-text mj-class="t-body">Hallo {contactfield=firstname|zusammen},</mj-text>
          <mj-text mj-class="t-body">danke für dein Interesse an Kopexa. Bestätige mit einem Klick, dass diese E-Mail-Adresse dir gehört. Erst danach schicken wir dir Neuigkeiten.</mj-text>
          <mj-button mj-class="t-btn t-btn-primary" href="{doi_link}">Anmeldung bestätigen</mj-button>
          <mj-text mj-class="k-note" padding="0 32px 8px 32px">Der Link ist 48 Stunden gültig.</mj-text>
          <mj-text mj-class="k-note" padding="0 32px 24px 32px">Du hast dich nicht angemeldet? Dann ignoriere diese E-Mail einfach. Ohne deine Bestätigung bekommst du von uns keine weiteren E-Mails.</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Footer on Navy: claim, legal information, unsubscribe -->
    <mj-section mj-class="k-navy" padding="32px 32px 8px 32px" css-class="k-footer">
      <mj-column>
        <mj-text mj-class="k-claim" padding="0 0 16px 0">Dein Weg zu mehr Sicherheit.</mj-text>
        <mj-text mj-class="k-fine" padding="0 0 8px 0">Kopexa GmbH · Schauenburgerstraße 116 · 24118 Kiel</mj-text>
        <mj-text mj-class="k-fine" padding="0 0 16px 0" css-class="k-footer"><a href="https://www.kopexa.com/de">kopexa.com</a> · <a href="https://kopexa.com/de/legal/imprint">Impressum</a> · <a href="https://kopexa.com/de/legal/privacy">Datenschutz</a></mj-text>
        <mj-text mj-class="k-fine" padding="0 0 32px 0" css-class="k-footer"><a href="{unsubscribe_url}">Abmelden oder Themen wählen</a> · <a href="{webview_url}">Im Browser ansehen</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
