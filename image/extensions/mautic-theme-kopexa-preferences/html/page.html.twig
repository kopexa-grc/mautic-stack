{% extends "@themes/"~template~"/html/base.html.twig" %}
{# Kopexa email preferences (Mautic preference center, brand.kopexa.com).
   Mautic replaces the tokens below with its own form parts and wraps a
   form around everything from the first token to the save button, so
   they all stay inside .kx-form. Mautic's own labels are English unless a
   language pack is installed: they are hidden here and replaced by our
   texts, wired to Mautic's fields (label for="email", the save function).
   Use the page as preference center: Mautic opens it from the
   unsubscribe link of every email; it only works from such a link. #}
{% set kx = 'themes/kopexa/assets/' %}

{% block content %}
<style>
  @font-face { font-family: 'IBM Plex Sans'; font-weight: 600; font-style: normal; font-display: swap; src: url('{{ getAssetUrl(kx~'fonts/IBM-Plex-Sans-600.ttf', null, null, true) }}') format('truetype'); }
  @font-face { font-family: 'Inter'; font-weight: 400; font-style: normal; font-display: swap; src: url('{{ getAssetUrl(kx~'fonts/Inter-400.ttf', null, null, true) }}') format('truetype'); }
  @font-face { font-family: 'Inter'; font-weight: 600; font-style: normal; font-display: swap; src: url('{{ getAssetUrl(kx~'fonts/Inter-600.ttf', null, null, true) }}') format('truetype'); }
  @font-face { font-family: 'Geist Mono'; font-weight: 400; font-style: normal; font-display: swap; src: url('{{ getAssetUrl(kx~'fonts/Geist-Mono-400.ttf', null, null, true) }}') format('truetype'); }

  /* Brand tokens (brand.kopexa.com/brand/tokens.json); --kx-muted and
     --kx-line are derived for white surfaces (muted text keeps > 4.5:1). */
  :root {
    --kx-navy: #070B14; --kx-text: #10253D; --kx-white: #FFFFFF;
    --kx-action: #006CB8; --kx-action-hover: #005B9B; --kx-supporting: #B9C8D7;
    --kx-muted: #475B70; --kx-line: #E1E6EC;
    --kx-r-small: 6px; --kx-r-control: 8px; --kx-r-panel: 14px; --kx-r-frame: 24px;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--kx-white); color: var(--kx-text); font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 16px; line-height: 1.6; -webkit-font-smoothing: antialiased; }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--kx-action); }
  a:focus-visible, button:focus-visible, input:focus-visible, label:focus-within { outline: 2px solid var(--kx-action); outline-offset: 3px; }

  .kx-wrap { width: 100%; max-width: 680px; margin: 0 auto; padding: 0 20px; }
  .kx-header .kx-wrap { display: flex; align-items: center; min-height: 68px; }
  .kx-logo { height: 26px; width: auto; }
  .kx-label { font-family: 'Geist Mono', ui-monospace, Menlo, monospace; font-size: 13px; letter-spacing: .04em; color: var(--kx-action); margin: 0 0 12px; }
  .kx-h1, .kx-h2 { font-family: 'IBM Plex Sans', Inter, Helvetica, Arial, sans-serif; font-weight: 600; color: var(--kx-navy); margin: 0; letter-spacing: -.02em; }
  .kx-h1 { font-size: 34px; line-height: 1.12; }
  .kx-h2 { font-size: 20px; line-height: 1.3; }
  .kx-lead { font-size: 18px; margin: 14px 0 0; }
  .kx-text { color: var(--kx-muted); margin: 6px 0 0; }
  .kx-intro { padding: 24px 0 28px; }

  /* confirmation after saving: shown when Mautic marks the save as successful */
  .pref-successmessage { display: none !important; }
  .kx-saved { display: none; border-radius: var(--kx-r-panel); background: var(--kx-navy); color: var(--kx-white); padding: 16px 20px; margin: 0 0 20px; font-weight: 600; }
  .kx-saved span { color: var(--kx-supporting); font-weight: 400; display: block; }
  body:has(.pref-successmessage:not([style*="none"])) .kx-saved { display: block; }

  /* cards */
  .kx-card { border: 1px solid var(--kx-line); border-radius: var(--kx-r-panel); padding: 22px 20px; margin: 0 0 16px; }

  /* topics: Mautic's category list ({categorylist}) as switch rows */
  .global-categories > div:first-child { display: none; }
  .global-categories { margin-top: 12px; display: flex; flex-direction: column; }
  .global-categories > div[id^="category-"] { display: flex; align-items: flex-start; gap: 14px; padding: 14px 0; border-top: 1px solid var(--kx-line); }
  .global-categories label { font-weight: 600; color: var(--kx-navy); cursor: pointer; flex: 1; padding-top: 2px; }
  /* name and text per topic (kopexa/mautic-preferences-center) */
  .global-categories .pref-topic-name { display: block; }
  .global-categories .pref-topic-text { display: block; font-weight: 400; color: var(--kx-muted); font-size: 15px; }
  .kx-form input[type="checkbox"] { appearance: none; -webkit-appearance: none; flex: none; margin: 0; width: 46px; height: 28px; border-radius: var(--kx-r-panel); background: var(--kx-supporting); position: relative; cursor: pointer; transition: background .15s; }
  .kx-form input[type="checkbox"]::after { content: ''; position: absolute; left: 3px; top: 3px; width: 22px; height: 22px; border-radius: var(--kx-r-panel); background: var(--kx-white); transition: transform .15s; }
  .kx-form input[type="checkbox"]:checked { background: var(--kx-action); }
  .kx-form input[type="checkbox"]:checked::after { transform: translateX(18px); }

  /* all emails: Mautic's channel switch ({channelfrequency}) with our label */
  .kx-all { display: grid; grid-template-columns: auto 1fr; column-gap: 14px; align-items: start; }
  .kx-all .kx-h2, .kx-all .kx-text { grid-column: 1 / -1; }
  .kx-all .pref-channelfrequency { grid-column: 1; grid-row: 3; margin-top: 14px; }
  .kx-all .pref-channelfrequency table, .kx-all .pref-channelfrequency td { border: 0; padding: 0; margin: 0; border-collapse: collapse; }
  .kx-all .pref-channelfrequency label { display: none; }
  /* Mautic's sample fields (frequency, pause) in the builder preview without a contact:
     only fields Mautic really renders carry data-contact-frequency / data-contact-pause-dates */
  .kx-all [id^="frequency_"] > div:not([data-contact-frequency]):not([data-contact-pause-dates]) { display: none; }
  .kx-all-label { grid-column: 2; grid-row: 3; margin-top: 14px; font-weight: 600; color: var(--kx-navy); cursor: pointer; padding-top: 2px; }
  .kx-all-label span { display: block; font-weight: 400; color: var(--kx-muted); font-size: 15px; }

  /* save: our button calls Mautic's save function; Mautic's own button is hidden */
  .prefs-saveprefs .btn-save { display: none !important; }
  .kx-button { display: block; width: 100%; text-align: center; background: var(--kx-action); color: var(--kx-white); font: inherit; font-weight: 600; font-size: 17px; padding: 15px 24px; min-height: 52px; border: 0; border-radius: var(--kx-r-control); cursor: pointer; }
  .kx-button:hover { background: var(--kx-action-hover); }
  .kx-fine { font-size: 13px; color: var(--kx-muted); margin: 14px 0 0; }

  .kx-footer { border-top: 1px solid var(--kx-line); margin-top: 48px; padding: 24px 0 32px; font-size: 14px; color: var(--kx-muted); }
  .kx-footer .kx-wrap { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; }
  .kx-footer nav { display: flex; gap: 24px; }
  .kx-footer a { color: var(--kx-muted); text-decoration: none; padding: 4px 0; }
  .kx-footer a:hover { color: var(--kx-action); text-decoration: underline; }

  @media (min-width: 640px) {
    .kx-wrap { padding: 0 32px; }
    .kx-h1 { font-size: 42px; }
    .kx-intro { padding: 48px 0 36px; }
    .kx-card { padding: 28px; }
    .kx-button { display: inline-block; width: auto; }
  }
</style>

<header class="kx-header">
  <div class="kx-wrap">
    <img class="kx-logo" src="{{ getAssetUrl(kx~'logo-dark.png', null, null, true) }}" alt="Kopexa" width="102" height="26">
  </div>
</header>

<main class="kx-wrap">
  <div class="kx-intro">
    <p class="kx-label">E-Mail-Einstellungen</p>
    <h1 class="kx-h1">Du entscheidest, was in deinem Postfach landet.</h1>
    <p class="kx-lead">Wähle die Themen, zu denen wir dir schreiben dürfen. Deine Auswahl gilt ab sofort.</p>
  </div>

  <div class="kx-saved" role="status">Gespeichert.<span>Deine Einstellungen gelten ab sofort. Du kannst sie jederzeit über den Link in unseren E-Mails ändern.</span></div>
  {successmessage}

  <div class="kx-form">
    <section class="kx-card">
      <h2 class="kx-h2">Themen</h2>
      <p class="kx-text">Hake an, worüber wir dich informieren dürfen.</p>
      {categorylist}
    </section>

    <section class="kx-card kx-all">
      <h2 class="kx-h2">Alle E-Mails</h2>
      <p class="kx-text">Ohne diesen Haken bekommst du keine E-Mails mehr von uns – auch nicht zu den Themen oben.</p>
      {channelfrequency}
      <label class="kx-all-label" for="email">E-Mails von Kopexa erhalten<span>Ausschalten, um dich von allen E-Mails abzumelden.</span></label>
    </section>

    <div class="kx-save">
      {saveprefsbutton}
      <button class="kx-button" type="button" onclick="if (typeof saveUnsubscribePreferences === 'function') { saveUnsubscribePreferences('lead_contact_frequency_rules'); }">Einstellungen speichern</button>
      <p class="kx-fine">Es gilt unsere <a href="https://kopexa.com/de/legal/privacy">Datenschutzerklärung</a>.</p>
    </div>
  </div>
</main>

<footer class="kx-footer">
  <div class="kx-wrap">
    <span>© Kopexa GmbH</span>
    <nav aria-label="Rechtliches"><a href="https://kopexa.com/de/legal/imprint">Impressum</a><a href="https://kopexa.com/de/legal/privacy">Datenschutz</a></nav>
  </div>
</footer>
{% endblock %}
