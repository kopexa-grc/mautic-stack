{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "labels": [
    "dependencies"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Mautic version: Dockerfile, Chart appVersion and Artifact Hub image annotation (one PR)",
      "managerFilePatterns": [
        "/^image/Dockerfile$/",
        "/^charts/mautic/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+ARG MAUTIC_VERSION=(?<currentValue>\\S+)",
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+appVersion: \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Tool images in workflow env blocks (scanners, helm-docs), optionally digest-pinned",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>[^\\s]+)\\s+[A-Z_]+_IMAGE: [^:\\s]+:(?<currentValue>[^@\\s]+)(@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ]
    },
    {
      "customType": "regex",
      "description": "Tool versions in workflow env blocks (helm, kubeconform, k3s)",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>[^\\s]+)\\s+[A-Z0-9_]+_VERSION: (?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Mautic image tag in the Artifact Hub annotation",
      "managerFilePatterns": [
        "/^charts/mautic/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "image: ghcr\\.io/kopexa-grc/mautic:(?<currentValue>[0-9][0-9.]*)"
      ],
      "datasourceTemplate": "packagist",
      "depNameTemplate": "mautic/recommended-project"
    },
    {
      "customType": "regex",
      "description": "Built-in Mautic extensions (exact pins in image/plugins.txt; wildcard pins follow Mautic)",
      "managerFilePatterns": [
        "/^image/plugins\\.txt$/"
      ],
      "matchStrings": [
        "(?m)^(?<depName>(?!kopexa/)[a-z0-9_.-]+/[a-z0-9_.-]+):(?<currentValue>v?[0-9][0-9.]*)$"
      ],
      "datasourceTemplate": "packagist"
    },
    {
      "customType": "regex",
      "description": "Our bundles in image/plugins.txt: GitHub releases of kopexa-grc/mautic-*-bundle (until they are on Packagist)",
      "managerFilePatterns": [
        "/^image/plugins\\.txt$/"
      ],
      "matchStrings": [
        "(?m)^kopexa/(?<pkg>mautic-[a-z]+-bundle):(?<currentValue>[0-9][0-9.]*)$"
      ],
      "depNameTemplate": "kopexa-grc/{{{pkg}}}",
      "packageNameTemplate": "kopexa-grc/{{{pkg}}}",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Mautic patch releases: automerge once the smoke test passes",
      "matchDepNames": [
        "mautic/recommended-project"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Mautic minor/major releases need a human look (migrations, breaking changes)",
      "matchDepNames": [
        "mautic/recommended-project"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "mautic-release"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "Extension updates are tested end-to-end before merge; only patches automerge",
      "matchFileNames": [
        "image/plugins.txt"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Our own bundles: grouped, tested end-to-end by the smoke test, automerged when green",
      "matchDepNames": [
        "kopexa-grc/mautic-oauth-bundle",
        "kopexa-grc/mautic-mcp-bundle",
        "kopexa-grc/mautic-postal-bundle"
      ],
      "groupName": "kopexa bundles",
      "automerge": true
    }
  ]
}
